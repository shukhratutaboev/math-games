@page "/gameoflife"
@using global::MathGames.Games
@inject GameOfLifeBase GoL
@implements IDisposable

<MudText Typo="Typo.h4" Class="mb-2">Conway's Game of Life</MudText>

<MudExpansionPanels Class="mb-4">
    <MudExpansionPanel Text="About Game of Life">
        <MudText Typo="Typo.body1" Class="mb-2">
            Conway's Game of Life is a cellular automaton devised by mathematician John Conway in 1970. 
            It consists of a grid of cells which, based on a few mathematical rules, can live, die, or multiply.
        </MudText>
        <MudText Typo="Typo.body1" Class="mb-4">
            <strong>Rules:</strong>
            <ul>
                <li>Any live cell with fewer than two live neighbors dies (underpopulation)</li>
                <li>Any live cell with two or three live neighbors lives on</li>
                <li>Any live cell with more than three live neighbors dies (overpopulation)</li>
                <li>Any dead cell with exactly three live neighbors becomes alive (reproduction)</li>
            </ul>
        </MudText>
        <MudText Typo="Typo.body2">
            Click on cells to toggle them between alive and dead. Use the controls to start/pause the simulation.
        </MudText>
    </MudExpansionPanel>
    
    <MudExpansionPanel Text="Preset Patterns">
        <MudText Typo="Typo.body1" Class="mb-2">
            Select a classic Game of Life pattern to load onto the grid:
        </MudText>
        <MudGrid>
            @foreach (var category in GameOfLifePatterns.GetCategories())
            {
                <MudItem xs="12" md="6" lg="4">
                    <MudText Typo="Typo.h6">@category</MudText>
                    @foreach (var pattern in GameOfLifePatterns.GetPatternsByCategory(category))
                    {
                        <MudButton OnClick="() => LoadPattern(pattern)" 
                                   Variant="Variant.Text" 
                                   Color="Color.Primary" 
                                   Size="Size.Small"
                                   Class="mb-1">
                            @pattern.Name
                        </MudButton>
                        <br/>
                    }
                </MudItem>
            }
        </MudGrid>
    </MudExpansionPanel>
</MudExpansionPanels>

@if (GoL is null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined">
            @if (GoL.Paused)
            {
                <MudButton OnClick="GoL.Play" StartIcon="@Icons.Material.Filled.PlayArrow">Play</MudButton>
            }
            else
            {
                <MudButton OnClick="GoL.Pause" StartIcon="@Icons.Material.Filled.Pause">Pause</MudButton>
            }
            <MudButton OnClick="GoL.Next" StartIcon="@Icons.Material.Filled.SkipNext">Step</MudButton>
            <MudButton OnClick="GoL.Randomize" StartIcon="@Icons.Material.Filled.Shuffle">Randomize</MudButton>
            <MudButton OnClick="GoL.Reset" StartIcon="@Icons.Material.Filled.Refresh">Reset</MudButton>
        </MudButtonGroup>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1">Refresh Rate: @((double)_refreshRate/1000) s</MudText>
        <MudSlider Value="@_refreshRate" ValueChanged="@((int val) => UpdateRefreshRate(val))" Min="100" Max="5000" Step="100" />
    </MudPaper>

    <MudPaper Class="pa-4">
        <div class="grid">
            @for (int row = 0; row < GoL.SizeX; row++)
            {
                @for (int col = 0; col < GoL.SizeY; col++)
                {
                    var x = row;
                    var y = col;
                    <div @onclick="() => GoL.ToggleCell(x, y)" class="cell @(GoL.GetCell(x, y) ? "alive" : "dead")"></div>
                }
            }
        </div>
    </MudPaper>
}
<style>
    .grid {
        display: grid;
        grid-template-rows: repeat(@(GoL?.SizeX ?? 0), 15px);
        grid-template-columns: repeat(@(GoL?.SizeY ?? 0), 15px);
    }
    .cell {
        width: 15px;
        height: 15px;
        border: 1px solid #ccc;
        cursor: pointer;
    }
    .alive {
        background-color: var(--mud-palette-primary);
    }
    .dead {
        background-color: white;
    }
</style>

@code {
    protected override void OnInitialized()
    {
        if (GoL != null)
        {
            GoL.OnChangeAsync += Refresh;
        }
    }

    private async Task Refresh()
    {
        if (GoL != null)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private int _refreshRate = 500;

    private void UpdateRefreshRate(int value)
    {
        _refreshRate = value;
        if (GoL != null)
        {
            GoL.SetRefreshRate(_refreshRate);
        }
    }

    private void LoadPattern(GameOfLifePatterns.Pattern pattern)
    {
        if (GoL != null)
        {
            GoL.LoadPatternCentered(pattern);
        }
    }

    public void Dispose()
    {
        if (GoL != null)
        {
            GoL.OnChangeAsync -= Refresh;
            GoL.Dispose();
        }
    }
}