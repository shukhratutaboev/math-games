@page "/gameoflife"
@using global::MathGames.Games
@inject GameOfLifeBase GoL

<MudText Typo="Typo.h5" Class="mb-4">Game of Life</MudText>

@if (GoL is null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined">
            @if (GoL.Paused)
            {
                <MudButton OnClick="GoL.Play" StartIcon="@Icons.Material.Filled.PlayArrow">Play</MudButton>
            }
            else
            {
                <MudButton OnClick="GoL.Pause" StartIcon="@Icons.Material.Filled.Pause">Pause</MudButton>
            }
            <MudButton OnClick="GoL.Next" StartIcon="@Icons.Material.Filled.SkipNext">Step</MudButton>
            <MudButton OnClick="GoL.Randomize" StartIcon="@Icons.Material.Filled.Shuffle">Randomize</MudButton>
            <MudButton OnClick="GoL.Reset" StartIcon="@Icons.Material.Filled.Refresh">Reset</MudButton>
        </MudButtonGroup>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1">Refresh Rate: @((double)_refreshRate/1000) s</MudText>
        <MudSlider Value="@_refreshRate" ValueChanged="@((int val) => UpdateRefreshRate(val))" Min="100" Max="5000" Step="100" />
    </MudPaper>

    <MudPaper Class="pa-4">
        <div class="grid">
            @for (int row = 0; row < GoL.SizeX; row++)
            {
                @for (int col = 0; col < GoL.SizeY; col++)
                {
                    var x = row;
                    var y = col;
                    <div @onclick="() => GoL.ToggleCell(x, y)" class="cell @(GoL.GetCell(x, y) ? "alive" : "dead")"></div>
                }
            }
        </div>
    </MudPaper>
}
<style>
    .grid {
        display: grid;
        grid-template-rows: repeat(@GoL.SizeX, 15px);
        grid-template-columns: repeat(@GoL.SizeY, 15px);
    }
    .cell {
        width: 15px;
        height: 15px;
        border: 1px solid #ccc;
        cursor: pointer;
    }
    .alive {
        background-color: var(--mud-palette-primary);
    }
    .dead {
        background-color: white;
    }
</style>

@code {
    protected override void OnInitialized()
    {
        if (GoL != null)
        {
            GoL.OnChangeAsync += Refresh;
        }
    }

    private async Task Refresh()
    {
        if (GoL != null)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private int _refreshRate = 500;

    private void UpdateRefreshRate(int value)
    {
        _refreshRate = value;
        if (GoL != null)
        {
            GoL.SetRefreshRate(_refreshRate);
        }
    }
}