@page "/"

<PageTitle>Math Games</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-2">
    <MudPaper Elevation="0" Class="hero-section pa-6 mb-5">
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Class="mb-4">Math + Simulation Playground</MudChip>
        <MudText Typo="Typo.h3" Class="mb-2">Build intuition through interactive models</MudText>
        <MudText Typo="Typo.body1" Class="hero-description mb-4">
            Explore cellular automata, predator-prey dynamics, and pathfinding with visual, real-time simulations.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="gameoflife" EndIcon="@Icons.Material.Filled.ArrowForward">Start Exploring</MudButton>
    </MudPaper>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <MudCard Class="feature-card">
                <MudCardContent>
                    <MudText Typo="Typo.h5" Class="mb-2">Conway's Game of Life</MudText>
                    <MudText Typo="Typo.body2">Watch complexity emerge from simple local rules.</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="gameoflife">Open</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard Class="feature-card">
                <MudCardContent>
                    <MudText Typo="Typo.h5" Class="mb-2">Langton's Ant</MudText>
                    <MudText Typo="Typo.body2">A tiny rule set that evolves into surprisingly structured behavior.</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="langtonsant">Open</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard Class="feature-card">
                <MudCardContent>
                    <MudText Typo="Typo.h5" Class="mb-2">Fox & Rabbit</MudText>
                    <MudText Typo="Typo.body2">Tune ecosystem parameters and observe predator-prey population cycles.</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="foxandrabbit">Open</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard Class="feature-card">
                <MudCardContent>
                    <MudText Typo="Typo.h5" Class="mb-2">Maze Generator & Solver</MudText>
                    <MudText Typo="Typo.body2">Compare generation and solving algorithms with visual step-by-step output.</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="maze">Open</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

<style>
    .hero-section {
        position: relative;
        border-radius: 20px;
        background: linear-gradient(130deg, rgba(89, 74, 226, 0.15) 0%, rgba(78, 205, 196, 0.18) 100%);
        border: 1px solid rgba(89, 74, 226, 0.2);
    }

    .hero-description {
        max-width: 760px;
        opacity: 0.9;
    }

    .feature-card {
        height: 100%;
        border-radius: 16px;
        border: 1px solid rgba(89, 74, 226, 0.15);
        transition: transform 140ms ease, box-shadow 140ms ease;
    }

    .feature-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 22px rgba(0, 0, 0, 0.12);
    }
</style>
