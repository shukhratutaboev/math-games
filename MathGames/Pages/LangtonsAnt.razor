@page "/langtonsant"
@using global::MathGames.Games
@inject LangtonsAntBase Ant

<MudText Typo="Typo.h4" Class="mb-4">Langton's Ant</MudText>

@if (Ant is null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined">
            @if (Ant.Paused)
            {
                <MudButton OnClick="Ant.Play" StartIcon="@Icons.Material.Filled.PlayArrow">Play</MudButton>
            }
            else
            {
                <MudButton OnClick="Ant.Pause" StartIcon="@Icons.Material.Filled.Pause">Pause</MudButton>
            }
            <MudButton OnClick="Ant.Next" StartIcon="@Icons.Material.Filled.SkipNext">Step</MudButton>
            <MudButton OnClick="Ant.Reset" StartIcon="@Icons.Material.Filled.Refresh">Reset</MudButton>
        </MudButtonGroup>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1">Refresh Rate: @((double)_refreshRate/1000) s</MudText>
        <MudSlider Value="@_refreshRate" ValueChanged="@((int val) => UpdateRefreshRate(val))" Min="1" Max="2000" Step="1" />
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.body1">Steps: @Ant.Steps</MudText>
    </MudPaper>

    <MudPaper Class="pa-4">
        <div class="grid">
            @for (int row = 0; row < Ant.SizeX; row++)
            {
                @for (int col = 0; col < Ant.SizeY; col++)
                {
                    var x = row;
                    var y = col;
                    if (Ant.AntX == x && Ant.AntY == y)
                    {
                        var direction = Ant.AntDirection switch
                        {
                            0 => "ant-up",
                            1 => "ant-right",
                            2 => "ant-down",
                            _ => "ant-left"
                        };
                        <div class="cell @direction @(Ant.GetCell(x, y) ? "black" : "white")"></div>
                    }
                    else
                    {
                        <div class="cell @(Ant.GetCell(x, y) ? "black" : "white")"></div>
                    }
                }
            }
        </div>
    </MudPaper>
}
<style>
    .grid {
        display: grid;
        grid-template-rows: repeat(@Ant.SizeX, 10px);
        grid-template-columns: repeat(@Ant.SizeY, 10px);
    }
    .cell {
        width: 10px;
        height: 10px;
        border: 1px solid #ccc;
    }
    .black {
        background-color: var(--mud-palette-primary);
    }
    .white {
        background-color: white;
    }
    .ant-up {
        border-width: 0 5px 10px 5px;
        border-color: transparent transparent var(--mud-palette-secondary) transparent;
    }
    .ant-right {
        border-width: 5px 0 5px 10px;
        border-color: transparent transparent transparent var(--mud-palette-secondary);
    }
    .ant-down {
        border-width: 10px 5px 0 5px;
        border-color: var(--mud-palette-secondary) transparent transparent transparent;
    }
    .ant-left {
        border-width: 5px 10px 5px 0;
        border-color: transparent var(--mud-palette-secondary) transparent transparent;
    }
</style>

@code {
    protected override void OnInitialized()
    {
        if (Ant != null)
        {
            Ant.OnChangeAsync += Refresh;
        }
    }

    private async Task Refresh()
    {
        if (Ant != null)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private int _refreshRate = 100;

    private void UpdateRefreshRate(int value)
    {
        _refreshRate = value;
        if (Ant != null)
        {
            Ant.SetRefreshRate(_refreshRate);
        }
    }
}