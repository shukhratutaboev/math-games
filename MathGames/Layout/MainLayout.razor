@inherits LayoutComponentBase
@using MathGames.Shared
@inject ThemeService ThemeService

<MudPopoverProvider />

<MudLayout Class="app-layout">
    <MudAppBar Elevation="0" Class="app-header">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <div class="brand-wrap">
            <MudText Typo="Typo.h5" Class="brand-title">Math Games Lab</MudText>
            <MudText Typo="Typo.caption" Class="brand-subtitle">Interactive simulations</MudText>
        </div>
        <MudSpacer />
        <MudTooltip Text="Toggle theme">
            <MudIconButton Icon="@(ThemeService.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" 
                           Color="Color.Inherit" 
                           OnClick="ToggleTheme" />
        </MudTooltip>
        <MudTooltip Text="View on GitHub">
            <MudIconButton Icon="@Icons.Material.Filled.Code" 
                           Color="Color.Inherit" 
                           Edge="Edge.End" 
                           Href="https://github.com/shukhratutaboev/math-games" 
                           Target="_blank" />
        </MudTooltip>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Class="app-drawer">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4 pt-4 content-shell">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    async Task ToggleTheme()
    {
        await ThemeService.ToggleThemeAsync();
        StateHasChanged();
    }
}
